+def _decode_block_override(
+    page_size: int, pages_per_seq: int, sliding_window: int | None
+) -> tuple[int, int, int, int] | None:
+    """Decode (bq, bkv, bq_c, bkv_c) from TPU_RPA_DECODE_BLOCK_SIZES, or None.
+
+    The variable holds `sliding=<bkv>:<bkv_c>,global=<bkv>:<bkv_c>` in tokens;
+    either entry may be left out. A layer with a sliding window takes the
+    `sliding` entry, any other layer the `global` one. Sizes are rounded to the
+    page size and clipped to the sequence capacity, and the compute chunk must
+    divide the block; an entry that does not is ignored, leaving the kernel's
+    own decode blocks.
+    """
+    spec = os.environ.get("TPU_RPA_DECODE_BLOCK_SIZES", "").strip()
+    if not spec:
+        return None
+    want = "sliding" if sliding_window is not None else "global"
+    max_kv = page_size * pages_per_seq
+    for item in spec.split(","):
+        name, _, sizes = item.strip().partition("=")
+        if name.strip() != want:
+            continue
+        try:
+            bkv, bkv_c = (int(v) for v in sizes.split(":"))
+        except ValueError:
+            return None
+        bkv = min(max_kv, -(-bkv // page_size) * page_size)
+        bkv_c = min(bkv, -(-bkv_c // page_size) * page_size)
+        if bkv <= 0 or bkv_c <= 0 or bkv % bkv_c:
+            return None
+        return (1, bkv, 1, bkv_c)
+    return None
+
