{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forward-bench-result.json",
  "title": "tpu-forward-bench Result",
  "description": "Output payload of the tpu-forward-bench agent: per arm, the jobs it ran, its step-mix cost and its A/B against the baseline arm, with the paths a later stage reads (evidence, traces, cost model, REPORT.md) and the replay record that reruns the identical test. Every number is a twin measurement or a modelled served projection, never a served result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "run_id"
  ],
  "status_requires": {
    "measured": [
      "arms",
      "cost_model",
      "replay",
      "report"
    ],
    "invalid_input": [
      "missing"
    ]
  },
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "measured",
        "invalid_input",
        "blocked",
        "failed"
      ],
      "description": "'measured': every arm ran or was settled, and was scored. 'invalid_input': the request cannot be run as given, an engine with no procedure here included; every gap is in `missing`. 'blocked': an adapter written for the model failed validation, a backend other than gke_job, a two-host plan, or no slot of the hardware key. 'failed': the baseline arm failed past the relaunch limit or hit `base_mismatch`, or a script failed. Every slot claimed is released before any of them is returned."
    },
    "summary": {
      "type": "string",
      "description": "Each candidate's speedup, significance and guardrails in one line."
    },
    "engine": {
      "enum": [
        "vllm"
      ],
      "description": "The request's engine, echoed."
    },
    "hardware": {
      "type": "string",
      "description": "The slot hardware key every job ran on."
    },
    "image": {
      "type": "string",
      "description": "The image every arm ran, by digest."
    },
    "plan": {
      "type": "string",
      "description": "The baseline arm's plan: a .steps.json, or a full-coverage plan directory."
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reviewed"
      ],
      "description": "The model adapter (model.py) every arm's plan was derived with. Present whenever it is unreviewed: one written for this run under the work dir's models/.",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "reviewed": {
          "type": "boolean",
          "description": "true for an adapter the package ships (model-specific or generic/model.py); false for one written per 'When no adapter fits'."
        }
      }
    },
    "coverage_pct": {
      "type": "number",
      "description": "Share of the source job's busy time the plan's cells cover."
    },
    "arms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "verdict",
          "job_ids",
          "patch"
        ],
        "oneOf": [
          {
            "description": "`plugin`, `patches`, or neither."
          },
          {
            "required": [
              "plugin",
              "patches"
            ],
            "description": "Both: matches here too, so it is rejected."
          }
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "baseline",
              "win",
              "tie",
              "loss",
              "base_mismatch"
            ],
            "description": "'win': significant speedup and no guardrail regressed. 'tie': inside noise. 'loss': slower or a regressed guardrail. 'base_mismatch': applier exit 4, no metric. Applier exit 4 cannot be a losing arm: the patch does not fit this image (for `plugin`, the ref's base is not this image's plugin commit), an input error."
          },
          "job_ids": {
            "type": "array",
            "description": "Every job of the arm in order, relaunches included.",
            "items": {
              "type": "string"
            }
          },
          "plugin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "base_sha",
              "ref",
              "sha",
              "patch"
            ],
            "description": "The request arm's `plugin`, echoed; absent when it had none.",
            "properties": {
              "repo": {
                "type": "string",
                "minLength": 1,
                "description": "The campaign repo (references/common/plugin-git.md)."
              },
              "base_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$",
                "description": "`base`: the image's own vllm_torchtpu commit."
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "description": "The branch or tag measured, e.g. `stack`, `hyp/2-moe-gate`."
              },
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$",
                "description": "The commit `ref` named when it was measured."
              },
              "patch": {
                "type": "string",
                "minLength": 1,
                "description": "`git diff base..sha` as plugin_source.py diff wrote it: the one patch the job applies, kept so the arm replays without the repo."
              }
            }
          },
          "patches": {
            "type": "array",
            "description": "The request arm's `patches`, echoed; absent when it had none.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "t_mix": {
            "type": "object",
            "additionalProperties": false,
            "description": "Seconds. `twin` is measured on the twin; `served` and `served_device` are modelled.",
            "properties": {
              "twin": {
                "type": "number"
              },
              "served": {
                "type": "number"
              },
              "served_device": {
                "type": "number"
              },
              "primary": {
                "enum": [
                  "twin",
                  "served",
                  "served_device"
                ],
                "description": "The basis mix-rollup marks primary for this change."
              }
            }
          },
          "speedup": {
            "type": "number",
            "description": "T_mix(baseline) / T_mix(arm) on the primary basis; absent for the baseline."
          },
          "significant": {
            "type": "boolean"
          },
          "noise_spread_pct": {
            "type": "number",
            "description": "The largest of repeat spread, profile_spread and boot spread, in percent."
          },
          "class_deltas": {
            "type": "object",
            "description": "Seconds each step class saved (negative) or cost, keyed by class.",
            "additionalProperties": true
          },
          "guardrails": {
            "type": "array",
            "description": "The heaviest decode cell and every mixed cell, baseline vs arm.",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "cell",
                "regressed"
              ],
              "properties": {
                "cell": {
                  "type": "string"
                },
                "regressed": {
                  "type": "boolean"
                }
              }
            }
          },
          "patch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stack",
              "exit",
              "outcome"
            ],
            "description": "evidence.json `patches`: what the job applied before the model loaded.",
            "properties": {
              "stack": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "exit": {
                "type": "integer",
                "description": "The first non-zero applier exit, else 0; 4 is verdict `base_mismatch`."
              },
              "outcome": {
                "type": "string"
              }
            }
          },
          "cost_model": {
            "type": "string",
            "description": "This arm's cost_model.json (mix-rollup with --baseline for a candidate)."
          },
          "evidence": {
            "type": "array",
            "description": "evidence.json per job.",
            "items": {
              "type": "string"
            }
          },
          "traces": {
            "type": "array",
            "description": "The rank-0 .xplane.pb per profiled job.",
            "items": {
              "type": "string"
            }
          },
          "ml_diagnostics_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "The ML Diagnostics viewer link per entry of `traces`, in the same order, copied from tpu-diagnostics' result; absent when the profile names no ML Diagnostics cluster and bucket."
          }
        }
      }
    },
    "cost_model": {
      "type": "string",
      "minLength": 1,
      "description": "The baseline arm's cost_model.json: T_mix, step weights and coverage."
    },
    "replay": {
      "type": "string",
      "minLength": 1,
      "description": "forward_bench_request.json: the request with `plan`, arm plans and `hardware` resolved. Sent back as a request, it reruns the identical test."
    },
    "report": {
      "type": "string",
      "description": "REPORT.md for this request's jobs.",
      "minLength": 1
    },
    "missing": {
      "type": "array",
      "description": "What the caller must change, when status is 'invalid_input'.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "reason"
        ],
        "properties": {
          "input": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "failure_reason": {
      "type": "string",
      "description": "What stopped the request, when status is 'blocked' or 'failed'."
    },
    "run_id": {
      "type": "string",
      "description": "Identifier of the active TPU agent suite run namespace."
    },
    "unscored": {
      "type": "boolean",
      "description": "True for a kernel_trace request: its traces are for diagnosis, and no verdict, speedup or T_mix from it is an A/B."
    }
  },
  "examples": [
    {
      "status": "measured",
      "summary": "moe-gate 1.041x served_device, significant, no guardrail regressed; async-collective tie.",
      "engine": "vllm",
