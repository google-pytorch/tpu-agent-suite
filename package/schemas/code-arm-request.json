{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "code-arm-request.json",
  "title": "tpu-code-arm Request",
  "description": "Input payload for the tpu-code-arm agent: test one `code` hypothesis on a gap by changing vllm_torchtpu code that is not a Pallas kernel, committed on the gap's branch of the campaign repo, on the given stack head. Every input is required but `stack_head.plugin`; a missing one fails validation rather than becoming a question.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "engine",
    "model",
    "gap",
    "hypothesis",
    "checkout",
    "stack_head",
    "target",
    "budget",
    "noise_floor_pct",
    "repo"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Identifier of the active TPU agent suite run namespace. The agent claims its slots from this run's parallel.json."
    },
    "engine": {
      "enum": [
        "vllm"
      ],
      "description": "The serving engine; its plugin is vllm_torchtpu."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "HuggingFace model id, org included."
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "layer_kind",
        "measured_ms",
        "floor_ms",
        "diagnosis",
        "evidence"
      ],
      "description": "The gap as tpu-performance-optimization ranked it and the hill-climb's 4.2 diagnosed it.",
      "properties": {
        "op": {
          "type": "string",
          "minLength": 1,
          "description": "The op or block, named as the roofline row it joins."
        },
        "layer_kind": {
          "type": "string",
          "minLength": 1
        },
        "measured_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Served ms per step on the stack head (measured)."
        },
        "floor_ms": {
          "type": "number",
          "minimum": 0,
          "description": "tpu-roofline's floor at the same scope (modelled)."
        },
        "diagnosis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "where",
            "why",
            "evidence"
          ],
          "properties": {
            "where": {
              "type": "string",
              "minLength": 1,
              "description": "Where the time goes: the file and function in vllm_torchtpu/."
            },
            "why": {
              "type": "string",
              "minLength": 1
            },
            "remove": {
              "type": "string",
              "minLength": 1
            },
            "class": {
              "enum": [
                "redundant-relayout",
                "kernel",
                "capacity",
                "correctness",
                "other"
              ],
              "description": "Triage's problem class for a gap it ranked (`kernel`, `redundant-relayout`); for work triage never ranked: `capacity` (KV pages, admission, sequences per engine), `correctness` (a crash or wrong output the change fixes), else `other`."
            },
            "evidence": {
              "type": "array",
              "description": "Paths of the queries, summaries and reports behind it.",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "description": "The gap file, the triage result and the profile reports, with the op's shapes and dtypes.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lever",
        "route",
        "claim",
        "expected_gain_pct",
        "evidence"
      ],
      "description": "One triage hypothesis with route `code`; a `kernel` one goes to tpu-pallas, a `flag-env` one is an override.",
      "properties": {
        "lever": {
          "type": "string",
          "minLength": 1,
          "description": "The code change."
        },
        "route": {
          "enum": [
            "code"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "description": "Why the op costs more than its floor and how the lever removes it."
        },
        "expected_gain_pct": {
          "type": "number",
          "description": "Served gain in percent (modelled)."
        },
        "cost": {
          "type": "string",
          "description": "What testing it spends, as triage wrote it."
        },
        "evidence": {
          "type": "array",
          "description": "Paths, source locations and knowledge-base citations behind the claim.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "branch",
        "revision"
      ],
      "description": "A worktree of the campaign repo on the gap's branch, from tpu-code-stack's `branch`, where the change is committed.",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "pattern": "^hyp/[A-Za-z0-9._-]+$",
          "description": "The gap's branch, e.g. `hyp/3-moe-gather`."
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "The `stack` commit the branch starts from."
        }
      }
    },
    "stack_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "description": "The current stack head: the pinned image and branch `stack` of the campaign repo. The returned commit descends from it.",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "Image pinned by digest."
        },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "base_sha",
            "ref",
            "sha",
            "patch"
          ],
          "description": "Branch `stack`; omitted while `stack` is at `base`.",
          "properties": {
            "repo": {
              "type": "string",
              "minLength": 1,
              "description": "The campaign repo (references/common/plugin-git.md)."
            },
            "base_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "description": "`base`: the image's own vllm_torchtpu commit."
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "description": "The branch or tag measured, e.g. `stack`, `hyp/2-moe-gate`."
            },
            "sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "description": "The commit `ref` named when it was measured."
            },
            "patch": {
              "type": "string",
              "minLength": 1,
              "description": "`git diff base..sha` as plugin_source.py diff wrote it: the one patch the job applies, kept so the arm replays without the repo."
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chip",
        "hardware"
      ],
      "description": "The TPU the probes run on and the slots they claim.",
      "properties": {
        "chip": {
          "type": "string",
          "minLength": 1,
          "description": "Chip type, e.g. tpu7x."
        },
        "hardware": {
          "type": "string",
          "minLength": 1,
          "description": "tpu_slots hardware key; every slot is claimed with --hardware set to it."
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobs"
      ],
      "description": "The most TPU jobs the arm may launch.",
      "properties": {
        "jobs": {
          "type": "integer",
          "minimum": 1,
          "default": 8
        }
      }
    },
    "noise_floor_pct": {
      "type": "number",
      "minimum": 0,
      "description": "Run-to-run spread of the stack microbenchmark, in percent (step 0's)."
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "description": "The campaign repo, for `commit` delegations to tpu-code-stack."
    }
  },
  "examples": [
    {
      "run_id": "20260921T120000Z-abcdef012345",
      "engine": "vllm",
      "model": "zai-org/GLM-5.2-FP8",
      "gap": {
        "op": "moe_gather",
        "layer_kind": "moe",
        "measured_ms": 1.84,
        "floor_ms": 0.62,
        "diagnosis": {
          "where": "vllm_torchtpu/layers/fused_moe.py: _gather_tokens",
          "why": "Tokens are gathered per expert, then concatenated: two HBM copies of the routed activations.",
          "remove": "Gather once with the sorted expert index.",
          "class": "redundant-relayout",
          "evidence": [
            "~/.tpu-agent-suite/runs/20260921T120000Z-abcdef012345/artifacts/diagnostics/g03.md"
          ]
        },
        "evidence": [
          "./.work/GLM-5.2-FP8/hill-climb/j-58d59d77/gaps/3-moe-gather.md"
        ]
      },
      "hypothesis": {
        "lever": "One take_along_axis on the sorted index in _gather_tokens instead of a per-expert gather and concat.",
        "route": "code",
        "claim": "The concat copies 2x the routed activations; one sorted gather removes it.",
        "expected_gain_pct": 2.1,
        "evidence": [
          "vllm_torchtpu/layers/fused_moe.py:212"
        ]
      },
      "checkout": {
        "path": "./.work/GLM-5.2-FP8/hill-climb/j-58d59d77/hyp-3-moe-gather",
        "branch": "hyp/3-moe-gather",
        "revision": "c2d5e8f1a4b7c0d3e6f9a2b5c8d1e4f7a0b3c6d9"
      },
      "stack_head": {
        "image": "<registry>/vllm-torchtpu@sha256:3f2a",
        "plugin": {
          "repo": "./.work/GLM-5.2-FP8/hill-climb/j-58d59d77/plugin",
          "base_sha": "9b1c4e7a2d5f8036a1b4c7d0e3f6a9b2c5d8e1f4",
          "ref": "stack",
          "sha": "c2d5e8f1a4b7c0d3e6f9a2b5c8d1e4f7a0b3c6d9",
          "patch": "./.work/GLM-5.2-FP8/hill-climb/j-58d59d77/patches/stack-c2d5e8f.patch"
        }
      },
      "target": {
        "chip": "tpu7x",
        "hardware": "tpu7x|2x2x1|8|<registry>/vllm-torchtpu@sha256:3f2a"
      },
      "budget": {
        "jobs": 8
      },
      "noise_floor_pct": 1.2,
      "repo": "./.work/GLM-5.2-FP8/hill-climb/j-58d59d77/plugin"
    }
  ]
}
