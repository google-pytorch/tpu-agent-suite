# Coverage configuration for the agent framework.
#
# Scope is deliberately narrow: `framework/` is the only
# centrally-maintained part of the codebase


[run]
source = framework
branch = True
parallel = False

omit =
    framework/tests/*
    framework/compute/drivers/zz_*
    package/*
    dist/*

[report]
precision = 1
show_missing = True
skip_covered = False

fail_under = 80

exclude_also =
    # Defensive branches that only fire on interpreter/platform edge cases.
    if TYPE_CHECKING:
    raise NotImplementedError
    if __name__ == .__main__.:
    except ImportError:

[html]
directory = htmlcov

[xml]
output = coverage.xml
