{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hillclimber Protocol Config",
  "description": "Evaluation protocol (main E2E or microbenchmark) sealed at campaign open.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workload_kind",
    "primary_metric",
    "compute_profile",
    "primary_metric_unit",
    "primary_metric_direction",
    "primary_metric_statistic",
    "measurement_cells",
    "min_replicates",
    "min_win_percentage",
    "noise_floor_percentage",
    "execution_spec"
  ],
  "properties": {
    "workload_kind": {
      "type": "string",
      "enum": [
        "inference",
        "training"
      ]
    },
    "primary_metric": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "\\S"
    },
    "compute_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "\\S"
    },
    "primary_metric_unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "\\S"
    },
    "primary_metric_direction": {
      "type": "string",
      "enum": [
        "maximum",
        "minimum"
      ]
    },
    "primary_metric_statistic": {
      "type": "string",
      "enum": [
        "mean",
        "median"
      ]
    },
    "measurement_cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topology",
          "weight"
        ],
        "properties": {
          "topology": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536,
            "pattern": "\\S"
          },
          "weight": {
            "type": "number"
          },
          "prefill": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "decode": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "concurrency": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "sequence_length": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "global_batch_size": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "per_device_batch_size": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    },
    "min_replicates": {
      "type": "integer",
      "minimum": 1
    },
    "min_win_percentage": {
      "type": "number",
      "minimum": 0.0
    },
    "max_cell_regression_percentage": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.0
    },
    "noise_floor_percentage": {
      "type": "number",
      "minimum": 0.0
    },
    "max_rounds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "max_barren_rounds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "target_improvement_percent": {
      "type": [
        "number",
        "null"
      ]
    },
    "accuracy_gate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "comparator",
            "threshold",
            "is_relative"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536,
              "pattern": "\\S"
            },
            "comparator": {
              "type": "string",
              "enum": [
                "gte",
                "lte"
              ]
            },
            "threshold": {
              "type": "number"
            },
            "is_relative": {
              "type": "boolean"
            },
            "relative_to": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      ]
    },
    "execution_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "\\S"
        },
        "microbenchmark_target": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "\\S"
        },
        "base_server_args": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_client_args": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_eval_args": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
